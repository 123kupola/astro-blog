---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const howtos = await getCollection('howtos');
  const publishedHowtos = howtos.filter(howto => howto.data.published);

  return publishedHowtos.map(howto => ({
    params: { slug: howto.slug },
    props: { howto },
  }));
}

const { howto } = Astro.props;
const { Content } = await howto.render();
---

<Layout title={`${howto.data.title} - ${siteConfig.title}`} description={howto.data.description || ''}>
  <main class="relative">
    <article class="max-w-4xl mx-auto px-4 py-12">
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class={`px-3 py-1 bg-gradient-to-r ${
            howto.data.difficulty === 'beginner' ? 'from-green-500/10 to-emerald-500/10 text-green-600 dark:text-green-400 border-green-500/20' :
            howto.data.difficulty === 'intermediate' ? 'from-yellow-500/10 to-orange-500/10 text-yellow-600 dark:text-yellow-400 border-yellow-500/20' :
            'from-red-500/10 to-pink-500/10 text-red-600 dark:text-red-400 border-red-500/20'
          } rounded-full text-sm font-medium border`}>
            {howto.data.difficulty.charAt(0).toUpperCase() + howto.data.difficulty.slice(1)}
          </span>
          <span class="text-sm text-muted-foreground">{howto.data.timeRequired || '15 min read'}</span>
        </div>

        <h1 class="text-4xl font-bold mb-4 text-gradient">{howto.data.title}</h1>
        <p class="text-xl text-muted-foreground mb-6">{howto.data.description}</p>

        <div class="flex items-center space-x-4 text-sm text-muted-foreground border-b border-border pb-6">
          <span>By {howto.data.author || 'Tech Team'}</span>
          <span>•</span>
          <span>{new Date(howto.data.date).toLocaleDateString()}</span>
          {howto.data.tags && (
            <>
              <span>•</span>
              <div class="flex gap-2">
                {howto.data.tags.map((tag: string) => (
                  <span class="px-2 py-1 bg-muted/50 border border-border/50 rounded text-xs">
                    {tag}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>
      </header>

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <Content />
      </div>

      <footer class="mt-12 pt-8 border-t border-border">
        <div class="flex justify-between items-center">
          <a href="/howtos" class="text-primary hover:text-primary/80 transition-colors">
            ← Back to Howtos
          </a>
          <div class="flex gap-4">
            <a href="/" class="text-muted-foreground hover:text-foreground transition-colors">
              Home
            </a>
            <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">
              Blog
            </a>
          </div>
        </div>
      </footer>
    </article>
  </main>
</Layout>