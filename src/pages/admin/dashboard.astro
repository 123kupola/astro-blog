---
import Layout from '../../layouts/Layout.astro';

const title = "Admin Dashboard";
const description = "Admin dashboard for managing site content";
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Admin Dashboard</h1>
          <p class="text-gray-600 dark:text-gray-400 mb-6">Welcome to the admin panel. Here you can manage your content.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-blue-50 dark:bg-blue-900/20 p-6 rounded-lg">
              <h3 class="text-lg font-medium text-blue-900 dark:text-blue-100 mb-2">Content Management</h3>
              <p class="text-blue-700 dark:text-blue-300 mb-4">Manage blog posts and pages</p>
              <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300">View Blog →</a>
            </div>

            <div class="bg-green-50 dark:bg-green-900/20 p-6 rounded-lg">
              <h3 class="text-lg font-medium text-green-900 dark:text-green-100 mb-2">Site Settings</h3>
              <p class="text-green-700 dark:text-green-300 mb-4">Configure site preferences</p>
              <span class="text-green-600 dark:text-green-400">Coming Soon</span>
            </div>

            <div class="bg-purple-50 dark:bg-purple-900/20 p-6 rounded-lg">
              <h3 class="text-lg font-medium text-purple-900 dark:text-purple-100 mb-2">Analytics</h3>
              <p class="text-purple-700 dark:text-purple-300 mb-4">View site statistics</p>
              <span class="text-purple-600 dark:text-purple-400">Coming Soon</span>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <form action="/api/auth/logout" method="POST" class="inline">
              <button type="submit" class="bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800 text-white px-4 py-2 rounded-md">
                Logout
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>