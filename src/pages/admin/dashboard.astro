---
/// <reference path="../../env.d.ts" />
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = "Admin Dashboard";
const description = "Admin dashboard for managing site content";

// User authentication is handled by middleware

// Load content server-side
let allContent: any[] = [];

// Get posts
try {
  const posts = await (getCollection as any)('posts');
  const postsWithMeta = posts.map((post: any) => ({
    id: post.slug,
    type: 'post',
    title: post.data.title || 'Untitled Post',
    description: post.data.description || '',
    date: post.data.date.toISOString(),
    author: post.data.author || 'Unknown',
    published: post.data.published,
    featured: post.data.featured || false,
    tags: post.data.tags || [],
    image: post.data.image,
    order: post.data.order || 0,
    url: `/blog/${post.slug}`
  }));
  allContent.push(...postsWithMeta);
} catch (error) {
  console.error('Error loading posts:', error);
}

// Get howtos
try {
  const howtos = await (getCollection as any)('howtos');
  const howtosWithMeta = howtos.map((howto: any) => ({
    id: howto.slug,
    type: 'howto',
    title: howto.data.title || 'Untitled How-to',
    description: howto.data.description || '',
    date: howto.data.date.toISOString(),
    author: howto.data.author || 'Unknown',
    published: howto.data.published,
    featured: howto.data.featured || false,
    tags: howto.data.tags || [],
    image: howto.data.image,
    difficulty: howto.data.difficulty,
    timeRequired: howto.data.timeRequired,
    order: howto.data.order || 0,
    url: `/howtos/${howto.slug}`
  }));
  allContent.push(...howtosWithMeta);
} catch (error) {
  console.error('Error loading howtos:', error);
}

// Sort by featured status (featured first), then by order, then by date
allContent.sort((a, b) => {
  // Featured items always come first
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;

  // For non-featured items, sort by order if available
  if (!a.featured && !b.featured) {
    const aOrder = a.order || 999;
    const bOrder = b.order || 999;
    if (aOrder !== bOrder) return aOrder - bOrder;
  }

  // Finally sort by date (newest first)
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-center justify-between mb-4">
              <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Admin Dashboard</h1>
              {(Astro.locals as any).user && (
                <div class="flex items-center space-x-3">
                  {(Astro.locals as any).user.image && (
                    <img src={(Astro.locals as any).user.image} alt={(Astro.locals as any).user.name || 'User'} class="w-8 h-8 rounded-full" />
                  )}
                  <div class="text-right">
                    <p class="text-sm font-medium text-gray-900 dark:text-gray-100">{(Astro.locals as any).user.name || 'User'}</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">{(Astro.locals as any).user.email}</p>
                    <p class="text-xs px-2 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 font-medium">
                      {(Astro.locals as any).user.role === 'admin' ? 'Admin' : 'User'}
                    </p>
                  </div>
                </div>
              )}
            </div>
            <p class="text-gray-600 dark:text-gray-400 mb-6">
              Welcome to the admin panel{(Astro.locals as any).user?.name ? `, ${(Astro.locals as any).user.name.split(' ')[0]}` : ''}. Here you can manage your content.
            </p>

          <!-- Content Management Interface -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
            <!-- Header with Actions -->
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
              <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Content Management</h2>
                 <div class="flex items-center space-x-3">
                   {(Astro.locals as any).user?.role === 'admin' && (
                     <>
                       <a
                         href="/admin/new-post"
                         class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                       >
                         <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                         </svg>
                         New Post
                       </a>
                       <a
                         href="/admin/new-howto"
                         class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                       >
                         <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                         </svg>
                         New How-to
                       </a>
                     </>
                   )}
                   {(Astro.locals as any).user?.role !== 'admin' && (
                     <div class="text-sm text-gray-500 dark:text-gray-400">
                       You have read-only access to the admin dashboard.
                     </div>
                   )}
                 </div>
              </div>
            </div>

            <!-- Filters and Search -->
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0">
                <div class="flex items-center space-x-4">
                  <div>
                    <label for="content-type" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Type</label>
                    <select id="content-type" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
                      <option value="">All Content</option>
                      <option value="posts">Posts</option>
                      <option value="howtos">How-tos</option>
                    </select>
                  </div>
                  <div>
                    <label for="content-status" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Status</label>
                    <select id="content-status" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
                      <option value="">All Status</option>
                      <option value="published">Published</option>
                      <option value="draft">Draft</option>
                    </select>
                  </div>
                </div>
                <div class="flex-1 max-w-lg">
                  <label for="search" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Search</label>
                  <div class="mt-1 relative">
                    <input
                      type="text"
                      id="search"
                      placeholder="Search content..."
                      class="block w-full pl-3 pr-10 py-2 border border-gray-300 dark:border-gray-600 rounded-md leading-5 bg-white dark:bg-gray-700 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 text-gray-900 dark:text-gray-100"
                    />
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content List -->
             <div id="content-list" class="divide-y divide-gray-200 dark:divide-gray-700" ondragover="handleDragOver(event)" ondrop="handleDrop(event)">
               {allContent.length === 0 ? (
                 <div class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                   <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                   </svg>
                   <h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-gray-100">No content found</h3>
                   <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Get started by creating your first post or how-to guide.</p>
                 </div>
               ) : (
                 allContent.map(item => (
                   <div class={`px-6 py-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 ${item.featured ? 'bg-purple-50 dark:bg-purple-900/10 border-l-4 border-purple-400' : ''}`} draggable={!item.featured} ondragstart={`handleDragStart(event, '${item.id}')`} data-id={item.id} data-featured={item.featured}>
                     <div class="flex items-center justify-between">
                       <div class="flex-1 min-w-0">
                         <div class="flex items-center space-x-3">
                           {!item.featured && (
                             <div class="flex-shrink-0 cursor-move">
                               <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
                               </svg>
                             </div>
                           )}
                           <div class="flex-shrink-0">
                             {item.image ? (
                               <img class="h-12 w-12 rounded-lg object-cover" src={item.image} alt={item.title} />
                             ) : (
                               <div class="h-12 w-12 rounded-lg bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
                                 <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                 </svg>
                               </div>
                             )}
                           </div>
                           <div class="min-w-0 flex-1">
                             <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">
                               <a href={item.url} target="_blank" class="hover:text-blue-600 dark:hover:text-blue-400">{item.title}</a>
                             </h3>
                             <p class="text-sm text-gray-500 dark:text-gray-400 truncate">{item.description}</p>
                             <div class="flex items-center space-x-4 mt-1">
                               <span class="text-xs text-gray-500 dark:text-gray-400">
                                 {item.type === 'post' ? '📝' : '📚'} {item.type}
                               </span>
                               <span class="text-xs text-gray-500 dark:text-gray-400">
                                 👤 {item.author}
                               </span>
                               <span class="text-xs text-gray-500 dark:text-gray-400">
                                 📅 {new Date(item.date).toLocaleDateString()}
                               </span>
                               {item.tags && item.tags.length > 0 && (
                                 <span class="text-xs text-gray-500 dark:text-gray-400">
                                   🏷️ {item.tags.slice(0, 2).join(', ')}{item.tags.length > 2 ? '...' : ''}
                                 </span>
                               )}
                             </div>
                           </div>
                         </div>
                       </div>
                       <div class="flex items-center space-x-3">
                         <!-- Status Badge -->
                         <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                           item.published
                             ? 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400'
                             : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400'
                         }`}>
                           {item.published ? 'Published' : 'Draft'}
                         </span>

                         <!-- Featured Toggle -->
                         <button
                           onclick={`toggleFeatured('${item.id}', ${item.featured})`}
                           class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium transition-colors ${
                             item.featured
                               ? 'bg-purple-100 text-purple-800 hover:bg-purple-200 dark:bg-purple-900/20 dark:text-purple-400 dark:hover:bg-purple-900/30'
                               : 'bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-400 dark:hover:bg-gray-600'
                           }`}
                           title={item.featured ? 'Remove from featured' : 'Mark as featured'}
                         >
                           {item.featured ? '★ Featured' : '☆ Feature'}
                         </button>

                          <!-- Action Buttons -->
                          {(Astro.locals as any).user?.role === 'admin' ? (
                            <div class="flex items-center space-x-2">
                              <button
                                onclick={`editContent('${item.id}')`}
                                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                                title="Edit"
                              >
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                              </button>
                              <button
                                onclick={`togglePublish('${item.id}', ${item.published})`}
                                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                                title={item.published ? 'Unpublish' : 'Publish'}
                              >
                                {item.published ? (
                                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                                  </svg>
                                ) : (
                                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                  </svg>
                                )}
                              </button>
                              <a
                                href={item.url}
                                target="_blank"
                                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                                title="View"
                              >
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                              </a>
                            </div>
                          ) : (
                            <div class="flex items-center space-x-2">
                              <a
                                href={item.url}
                                target="_blank"
                                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                                title="View"
                              >
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                              </a>
                              <span class="text-xs text-gray-400 dark:text-gray-500">Read-only</span>
                            </div>
                          )}
                       </div>
                     </div>
                   </div>
                 ))
               )}
             </div>

            <!-- Pagination -->
            <div id="pagination" class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 hidden">
              <!-- Pagination controls will be added here -->
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <button
              id="logout-btn"
              class="bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-800 text-white px-4 py-2 rounded-md"
            >
              Logout
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authClient } from '../../lib/auth-client';

    // Content management state
    let draggedElement = null;

    // Toggle publish status
    async function togglePublish(id, currentStatus) {
      try {
        const response = await fetch(`/api/admin/content`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            action: 'toggle-publish',
            id: id
          }),
        });

        const result = await response.json();

        if (result.success) {
          // Update the DOM element
          const item = document.querySelector(`[data-id="${id}"]`);
          if (item) {
            const statusBadge = item.querySelector('.inline-flex.items-center.px-2\\.5.py-0\\.5');
            if (statusBadge) {
              if (result.data.published) {
                statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400';
                statusBadge.textContent = 'Published';
              } else {
                statusBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400';
                statusBadge.textContent = 'Draft';
              }
            }
            // Update publish button
            const publishBtn = item.querySelector('button[title*="Publish"], button[title*="Unpublish"]');
            if (publishBtn) {
              publishBtn.setAttribute('title', result.data.published ? 'Unpublish' : 'Publish');
              publishBtn.innerHTML = result.data.published ? `
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"></path>
                </svg>
              ` : `
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              `;
            }
          }
          showSuccess(`Content ${result.data.published ? 'published' : 'unpublished'} successfully`);
        } else {
          showError(result.error || 'Failed to update content status');
        }
      } catch (error) {
        console.error('Error toggling publish status:', error);
        showError('Failed to update content status');
      }
    }

    // Toggle featured status
    async function toggleFeatured(id, currentStatus) {
      try {
        const response = await fetch(`/api/admin/content`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            action: 'toggle-featured',
            id: id
          }),
        });

        const result = await response.json();

        if (result.success) {
          // Update the DOM element
          const item = document.querySelector(`[data-id="${id}"]`);
          if (item) {
            item.setAttribute('data-featured', String(result.data.featured));
            if (result.data.featured) {
              item.classList.add('bg-purple-50', 'dark:bg-purple-900/10', 'border-l-4', 'border-purple-400');
            } else {
              item.classList.remove('bg-purple-50', 'dark:bg-purple-900/10', 'border-l-4', 'border-purple-400');
            }

            // Update featured button
            const featuredBtn = item.querySelector('button[title*="featured"]');
            if (featuredBtn) {
              featuredBtn.setAttribute('title', result.data.featured ? 'Remove from featured' : 'Mark as featured');
              featuredBtn.innerHTML = result.data.featured ? '★ Featured' : '☆ Feature';
              if (result.data.featured) {
                featuredBtn.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 hover:bg-purple-200 dark:bg-purple-900/20 dark:text-purple-400 dark:hover:bg-purple-900/30';
              } else {
                featuredBtn.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-400 dark:hover:bg-gray-600';
              }
            }

            // Update drag handle visibility
            const dragHandle = item.querySelector('.cursor-move') as HTMLElement;
            if (dragHandle) {
              dragHandle.style.display = result.data.featured ? 'none' : 'block';
            }

            // Update draggable attribute
            item.setAttribute('draggable', String(!result.data.featured));
          }
          showSuccess(`Content ${result.data.featured ? 'marked as featured' : 'removed from featured'} successfully`);
        } else {
          showError(result.error || 'Failed to update featured status');
        }
      } catch (error) {
        console.error('Error toggling featured status:', error);
        showError('Failed to update featured status');
      }
    }

    // Edit content
    function editContent(id) {
      // Find the content type by checking the item
      const item = document.querySelector(`[data-id="${id}"]`);
      if (item) {
        const typeText = item.textContent || '';
        if (typeText.includes('📝') || typeText.includes('post')) {
          window.location.href = `/admin/edit-post?id=${id}`;
        } else if (typeText.includes('📚') || typeText.includes('howto')) {
          window.location.href = `/admin/edit-howto?id=${id}`;
        }
      } else {
        showError('Content not found');
      }
    }

    // Drag and drop functionality
    function handleDragStart(event, id) {
      draggedElement = id;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/html', event.target.outerHTML);
      (event.target as HTMLElement).style.opacity = '0.5';
    }

    function handleDragOver(event) {
      event.preventDefault();
      event.dataTransfer.dropEffect = 'move';
      return false;
    }

    function handleDrop(event) {
      event.preventDefault();

      if (!draggedElement) return;

      const targetElement = event.target.closest('[data-id]');
      if (!targetElement) return;

      const targetId = targetElement.getAttribute('data-id');
      const targetFeatured = targetElement.getAttribute('data-featured') === 'true';

      // Don't allow dropping on featured items or if dragging a featured item
      const draggedItem = document.querySelector(`[data-id="${draggedElement}"]`);
      if (!draggedItem || draggedItem.getAttribute('data-featured') === 'true' || targetFeatured) {
        return;
      }

      // Move the dragged element to the new position
      const contentList = document.getElementById('content-list');
      if (!contentList) return;

      const draggedElementNode = draggedItem;
      const targetElementNode = targetElement;

      // Insert before or after based on position
      const rect = targetElement.getBoundingClientRect();
      const midpoint = rect.top + rect.height / 2;

      if (event.clientY < midpoint) {
        // Insert before
        contentList.insertBefore(draggedElementNode, targetElementNode);
      } else {
        // Insert after
        contentList.insertBefore(draggedElementNode, targetElementNode.nextSibling);
      }

      // Update order in backend
      updateOrder();

      draggedElement = null;

      // Reset opacity
      (draggedItem as HTMLElement).style.opacity = '1';

      return false;
    }

    async function updateOrder() {
      try {
        const contentItems = document.querySelectorAll('[data-id]');
        const nonFeaturedItems = Array.from(contentItems)
          .filter(item => item.getAttribute('data-featured') !== 'true')
          .map((item, index) => ({
            id: item.getAttribute('data-id'),
            type: item.textContent?.includes('📝') ? 'post' : 'howto',
            order: index + 1
          }));

        const response = await fetch('/api/admin/content', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            action: 'update-order',
            order: nonFeaturedItems
          }),
        });

        const result = await response.json();

        if (!result.success) {
          console.error('Failed to update order:', result.error);
          // Reload page to revert changes
          window.location.reload();
        }
      } catch (error) {
        console.error('Error updating order:', error);
        // Reload page to revert changes
        window.location.reload();
      }
    }

    // Show success message
    function showSuccess(message) {
      // Simple alert for now - could be enhanced with toast notifications
      alert(`✅ ${message}`);
    }

    // Show error message
    function showError(message) {
      alert(`❌ ${message}`);
    }

    // Event listeners
    document.addEventListener('DOMContentLoaded', () => {
      // Filter event listeners
      document.getElementById('content-type')?.addEventListener('change', (e) => {
        // For now, just reload with filters
        const type = (e.target as HTMLSelectElement).value;
        const url = new URL(window.location.href);
        if (type) {
          url.searchParams.set('type', type);
        } else {
          url.searchParams.delete('type');
        }
        window.location.href = url.toString();
      });

      document.getElementById('content-status')?.addEventListener('change', (e) => {
        const status = (e.target as HTMLSelectElement).value;
        const url = new URL(window.location.href);
        if (status) {
          url.searchParams.set('status', status);
        } else {
          url.searchParams.delete('status');
        }
        window.location.href = url.toString();
      });

      document.getElementById('search')?.addEventListener('input', (e) => {
        const search = (e.target as HTMLInputElement).value;
        const url = new URL(window.location.href);
        if (search) {
          url.searchParams.set('search', search);
        } else {
          url.searchParams.delete('search');
        }
        window.location.href = url.toString();
      });

      // Logout functionality
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        try {
          await authClient.signOut({
            fetchOptions: {
              onSuccess: () => {
                window.location.href = '/admin';
              },
              onError: () => {
                alert('Failed to sign out. Please try again.');
              }
            }
          });
        } catch (error) {
          console.error('Logout error:', error);
          alert('Failed to sign out. Please try again.');
        }
      });
    });
  </script>
</Layout>