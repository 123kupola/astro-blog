---
// Tech Button Component
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
}

const { 
  variant = 'primary', 
  size = 'md', 
  href, 
  type = 'button', 
  disabled = false,
  class: extraClass = '' 
} = Astro.props;

const baseClasses = 'relative overflow-hidden transition-all duration-300 focus-ring font-medium rounded-xl btn-tech';
const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const variantClasses = {
  primary: 'bg-gradient-to-r from-blue-600 to-purple-600 text-white hover:shadow-2xl hover:scale-105',
  secondary: 'bg-background border border-border hover:bg-muted hover:scale-105',
  ghost: 'bg-muted/50 hover:bg-muted hover:scale-105'
};

const classes = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${extraClass} ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled}>
    <slot />
  </button>
)}