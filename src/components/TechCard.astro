---
// Tech Card Component
export interface Props {
  title: string;
  description: string;
  icon?: string;
  gradient?: string;
  href?: string;
}

const { title, description, icon, gradient = 'from-blue-500 to-purple-600', href } = Astro.props;
---

<div class="relative group cursor-pointer">
  <div class="absolute inset-0 bg-gradient-to-r {gradient} opacity-10 rounded-2xl transform group-hover:scale-105 transition-transform duration-300"></div>
  <div class="relative p-6 bg-background/80 backdrop-blur-sm border border-border/50 rounded-2xl hover:shadow-2xl transition-all duration-300 card-tech">
    {icon && (
      <div class="w-12 h-12 bg-gradient-to-br {gradient} rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
          <path d={icon} />
        </svg>
      </div>
    )}
    <h3 class="text-xl font-semibold mb-2">{title}</h3>
    <p class="text-muted-foreground">{description}</p>
  </div>
</div>