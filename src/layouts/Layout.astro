---
import { siteConfig as SITE } from '../config';
import '../styles/global.css';
export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/og-image.jpg' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={SITE.site} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground">
    <div class="min-h-screen flex flex-col relative overflow-hidden">
      <!-- Animated background gradient -->
      <div class="fixed inset-0 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-gray-900 dark:via-blue-900/20 dark:to-purple-900/20 -z-10"></div>

      
      <header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl shadow-lg shadow-black/5 dark:shadow-black/20">
        <div class="container mx-auto px-4 py-4">
          <nav class="flex items-center justify-between">
            <a href="/" class="group flex items-center space-x-2">
              <img src="/logo.png" alt="Webomat Logo" class="h-8 w-auto transform group-hover:scale-110 transition-transform">
              <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">{SITE.title}</span>
            </a>

             <div class="hidden md:flex items-center space-x-6">
               <a href="/" class="relative text-sm font-medium hover:text-primary transition-colors group">
                 <span class="relative z-10">Home</span>
                 <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
               </a>
                <a href="/about" class="relative text-sm font-medium hover:text-primary transition-colors group">
                  <span class="relative z-10">About</span>
                  <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
                </a>
                <a href="/howtos" class="relative text-sm font-medium hover:text-primary transition-colors group">
                  <span class="relative z-10">Howtos</span>
                  <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
                </a>
                <a href="/blog" class="relative text-sm font-medium hover:text-primary transition-colors group">
                  <span class="relative z-10">Blog</span>
                  <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
                </a>
             </div>

              <div class="flex items-center space-x-4">
                <a id="login-link" href="/admin" class="relative text-sm font-medium hover:text-primary transition-colors group">
                  <span class="relative z-10">Login</span>
                  <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
                </a>

                <button id="theme-toggle" class="relative p-2 rounded-lg bg-muted/50 hover:bg-muted transition-all hover:scale-105 group">
                  <svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                  </svg>
                  <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
                </button>
              </div>
          </nav>
        </div>
      </header>

      <main class="flex-1 relative">
        <slot />
      </main>

      <footer class="border-t border-border/40 bg-background/80 backdrop-blur-xl mt-auto">
        <div class="container mx-auto px-4 py-8">
          <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 bg-gradient-to-br from-blue-500 to-purple-600 rounded flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                </svg>
              </div>
              <p class="text-sm text-muted-foreground">&copy; 2024 {SITE.title}. Built with passion.</p>
            </div>
            
            <div class="flex items-center space-x-4">
              <a href={SITE.navigation.social.find(s => s.title === 'GitHub')?.url} class="relative p-2 rounded-lg bg-muted/50 hover:bg-muted transition-all hover:scale-105 group">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
              </a>
              <a href={SITE.navigation.social.find(s => s.title === 'X')?.url} class="relative p-2 rounded-lg bg-muted/50 hover:bg-muted transition-all hover:scale-105 group">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Enhanced theme toggle functionality
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      
      // Check for saved theme preference or default to system preference
      const getPreferredTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) return savedTheme;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const currentTheme = getPreferredTheme();
      html.classList.toggle('dark', currentTheme === 'dark');
      
      // Update theme toggle icon
      const updateThemeIcon = (isDark: boolean) => {
        if (themeToggle) {
          themeToggle.innerHTML = isDark ? 
            `<svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>` :
            `<svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>`;
        }
      };
      
      updateThemeIcon(currentTheme === 'dark');
      
      themeToggle?.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeIcon(isDark);
        
        // Add a subtle animation to the body
        document.body.style.transition = 'background-color 0.3s ease';
      });
      
      // Listen for system theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          const isDark = e.matches;
          html.classList.toggle('dark', isDark);
          updateThemeIcon(isDark);
        }
      });
      
       // Add keyboard shortcut for theme toggle (Ctrl/Cmd + Shift + D)
       document.addEventListener('keydown', (e) => {
         if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'D') {
           e.preventDefault();
           themeToggle?.click();
         }
       });

        // Check login status and update nav
        fetch('/api/auth/check')
          .then(response => response.json())
          .then(data => {
            const loginLink = document.getElementById('login-link');
            if (loginLink) {
              if (data.loggedIn) {
                // Replace login link with logout button
                const logoutButton = document.createElement('button');
                logoutButton.className = 'relative text-sm font-medium hover:text-primary transition-colors group';
                logoutButton.innerHTML = `
                  <span class="relative z-10">Logout</span>
                  <div class="absolute inset-0 bg-primary/10 rounded scale-0 group-hover:scale-100 transition-transform"></div>
                `;
                logoutButton.addEventListener('click', async () => {
                  try {
                    // Simple logout via API call
                    const response = await fetch('/api/auth/logout', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json',
                      },
                    });

                    if (response.ok) {
                      window.location.href = '/';
                    } else {
                      throw new Error('Logout failed');
                    }
                  } catch (error) {
                    console.error('Logout error:', error);
                    alert('Logout failed. Please try again.');
                  }
                });
                loginLink.replaceWith(logoutButton);
              }
            }
          })
          .catch(err => console.error('Failed to check login status', err));
    </script>
  </body>
</html>